# ─────────────────────────────────────────────────────────────────────────────
# Monkey — variables de entorno
# Copiá este archivo a `.env` y completá lo que haga falta.
# Todo esto se valida con Zod en src/env.ts al arrancar: si algo está mal,
# el proceso no levanta.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# URL pública de la app. En producción TIENE que ser https (cookies Secure).
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ── Base de datos ────────────────────────────────────────────────────────────
# Coincide con el servicio `postgres` de docker-compose.yml
DATABASE_URL=postgresql://monkey:monkey@localhost:5442/monkey?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generalo con:  openssl rand -base64 48
# o en PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
AUTH_SECRET=cambiame-por-un-secreto-de-al-menos-32-caracteres

# Ventana de revocación de sesión (§0.2 del plan): un access token revocado
# sigue siendo válido como mucho estos minutos.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7

# ── Mail ─────────────────────────────────────────────────────────────────────
# console = imprime el mail por stdout (solo dev)
# smtp    = cualquier SMTP, incluido Mailpit del compose
# resend  = producción
MAIL_DRIVER=smtp
MAIL_FROM=Monkey <no-reply@monkey.local>

# MAIL_DRIVER=resend
RESEND_API_KEY=

# MAIL_DRIVER=smtp — con el compose de dev, Mailpit escucha en 1025
# y su interfaz web queda en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── Defaults regionales ──────────────────────────────────────────────────────
# Son solo el punto de partida: cada usuario elige lo suyo en el registro y
# cada Space tiene su propia moneda y timezone. Nada de esto está hardcodeado
# en el código.
#   España:   es-ES / EUR / Europe/Madrid
#   Argentina: es-AR / ARS / America/Argentina/Buenos_Aires
DEFAULT_LOCALE=es-ES
DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Madrid

# ── Storage (adjuntos — Fase 3) ──────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads

# ── Jobs (recurrentes) ───────────────────────────────────────────────────────
# Obligatorio en producción. Protege POST /api/v1/jobs/recurring, que es el
# único endpoint que cruza Spaces y el único que no se autentica con sesión.
#
# Generar con: openssl rand -base64 32
#
# Crontab sugerido (todos los días a las 03:15). El job es idempotente: si se
# dispara dos veces no duplica nada.
#   15 3 * * * curl -fsS -X POST \
#     -H "Authorization: Bearer $CRON_SECRET" \
#     https://monkey.example/api/v1/jobs/recurring
CRON_SECRET=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
