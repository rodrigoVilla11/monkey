// ─────────────────────────────────────────────────────────────────────────────
// monKey — esquema de datos
//
// Invariantes de todo el dominio financiero:
//  · Toda entidad financiera cuelga de `spaceId`. Sin excepciones salvo
//    ExchangeRate, que es global y está en el allowlist de la extensión.
//  · Nada de floats para dinero: BigInt en la unidad mínima de la moneda,
//    con su `currency` ISO 4217 al lado.
//  · Los importes se guardan SIEMPRE positivos; el signo lo determina el
//    `type` de la transacción.
//  · Las fechas de hecho económico son @db.Date (fecha calendario, sin hora
//    ni timezone). Los instantes de sistema son DateTime (timestamptz).
//  · Los tokens se guardan hasheados. Nunca en texto plano.
//
// ── Integridad referencial dentro del Space ──────────────────────────────────
// Toda relación entre dos entidades del dominio usa una clave foránea
// COMPUESTA (spaceId, id) en vez de solo (id). Los modelos que son destino de
// una FK llevan @@unique([spaceId, id]) para permitirlo.
//
// Por qué: la extensión de scope garantiza que una fila nueva nazca con el
// spaceId correcto, pero no valida los IDs que vienen en el body. Sin FK
// compuesta, un service con un bug podría crear una transacción en el Space A
// apuntando a una cuenta del Space B — y la extensión no lo vería.
// Con FK compuesta eso es un error de PostgreSQL, no un bug silencioso.
//
// Consecuencia: esas relaciones no pueden usar onDelete: SetNull, porque
// Postgres anularía TODAS las columnas de la FK, incluida spaceId (que es NOT
// NULL). Usan Restrict, que es coherente con el borrado lógico del resto.
// Las FKs hacia User sí quedan simples: User no está scopeado por Space.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// Prisma 7 sacó `url` del schema: la URL para Migrate vive en prisma.config.ts
/// y el cliente en runtime se conecta con un driver adapter (@prisma/adapter-pg).
datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════ enums ═══════════════════════════════════

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  INVESTMENT
  CRYPTO
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CLEARED
}

/// Lado de una transferencia. Una transferencia son DOS transacciones con el
/// mismo transferGroupId: la que sale de una cuenta (OUT) y la que entra en la
/// otra (IN).
///
/// Hace falta porque en el resto del dominio el signo lo determina `type`
/// (INCOME suma, EXPENSE resta), pero las dos patas de una transferencia
/// comparten el tipo TRANSFER y afectan al saldo en sentidos opuestos.
enum TransferDirection {
  OUT
  IN
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
  CUSTOM
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtDirection {
  OWED_TO_ME
  OWED_BY_ME
}

enum AuditAction {
  SPACE_CREATED
  SPACE_UPDATED
  SPACE_DELETED
  SPACE_OWNERSHIP_TRANSFERRED
  MEMBER_INVITED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_LEFT
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_DELETED
  ACCOUNT_ARCHIVED
  CATEGORY_DELETED
  TRANSACTIONS_BULK_DELETED
}

// ═══════════════════════════ identidad y acceso ═════════════════════════════

model User {
  id           String  @id @default(cuid(2))
  /// Siempre normalizado (lowercase + trim) por normalizeEmail(). Eso da la
  /// unicidad case-insensitive sin necesitar la extensión citext.
  email        String  @unique
  passwordHash String
  name         String
  avatarUrl    String?

  /// Se proponen desde DEFAULT_LOCALE / DEFAULT_TIMEZONE, pero cada persona
  /// tiene los suyos: en un Space compartido puede haber gente en husos
  /// distintos.
  timezone String
  locale   String

  emailVerifiedAt DateTime?

  /// Último Space que la persona estaba usando. Es solo el default de la UI:
  /// la autorización real sale siempre del spaceId de la URL contrastado con
  /// Membership. Vive acá y no en el token para que sobreviva al refresh y se
  /// comparta entre dispositivos.
  activeSpaceId String?

  // preferencias
  theme        ThemePreference @default(SYSTEM)
  /// 0 = domingo … 6 = sábado. Afecta reportes semanales y presupuestos WEEKLY.
  weekStartsOn Int             @default(1)

  // seguridad
  /// Rate limiting por email que sobrevive a un redeploy (el de IP es en memoria).
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  /// Revocación dura: invalida todo access token emitido antes de esta marca.
  /// Se usa en el reset de password, donde no se puede esperar al TTL.
  sessionsRevokedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activeSpace         Space?              @relation("UserActiveSpace", fields: [activeSpaceId], references: [id], onDelete: SetNull)
  memberships         Membership[]        @relation("MembershipUser")
  invitedMemberships  Membership[]        @relation("MembershipInviter")
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  sentInvitations     Invitation[]        @relation("InvitationInviter")
  acceptedInvitations Invitation[]        @relation("InvitationAcceptor")
  auditLogs           AuditLog[]
  transactions        Transaction[]
  paidTransactions    Transaction[]       @relation("TransactionPayer")
  recurringRules      RecurringRule[]
  attachments         Attachment[]
  splits              TransactionSplit[]
  settlementsSent     Settlement[]        @relation("SettlementFrom")
  settlementsReceived Settlement[]        @relation("SettlementTo")

  @@index([deletedAt])
}

model Space {
  id String @id @default(cuid(2))

  name            String
  /// Moneda de consolidación de reportes. Cada transacción guarda además su
  /// propia moneda y, si difiere, el tipo de cambio congelado.
  primaryCurrency String  @db.Char(3)
  timezone        String
  icon            String?
  color           String?

  /// El Space que se crea solo al registrarse. No se puede borrar si es el
  /// único que le queda al usuario.
  isPersonal Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships     Membership[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  /// Contra-lado de User.activeSpaceId. No implica permisos: solo recuerda
  /// qué Space tenía abierto cada persona.
  activeForUsers  User[]                @relation("UserActiveSpace")
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  tags            Tag[]
  transactionTags TransactionTag[]
  budgets         Budget[]
  recurringRules  RecurringRule[]
  savingsGoals    SavingsGoal[]
  savingsContribs SavingsContribution[]
  debts           Debt[]
  debtPayments    DebtPayment[]
  attachments     Attachment[]
  splits          TransactionSplit[]
  settlements     Settlement[]

  @@index([deletedAt])
}

model Membership {
  id      String         @id @default(cuid(2))
  userId  String
  spaceId String
  role    MembershipRole

  joinedAt        DateTime @default(now())
  invitedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  space     Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  /// Este unique ya provee el índice (userId, spaceId) que pide el brief.
  @@unique([userId, spaceId])
  @@index([spaceId, role])
}

model Invitation {
  id      String         @id @default(cuid(2))
  spaceId String
  /// Normalizado igual que User.email.
  email   String
  role    MembershipRole

  /// sha256 del token. El token en claro solo existe en el mail que se manda.
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  invitedByUserId  String?
  acceptedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space      Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  invitedBy  User? @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  /// "una sola invitación pendiente por (spaceId, email)" es un unique PARCIAL:
  /// Prisma no lo expresa, va a mano en la migración inicial.

  @@index([spaceId, email])
  @@index([email, acceptedAt])
}

model RefreshToken {
  id     String @id @default(cuid(2))
  userId String

  tokenHash String @unique

  deviceLabel String?
  userAgent   String?
  /// Hasheada: sirve para detectar anomalías sin guardar la IP en claro.
  ipHash      String?

  expiresAt         DateTime
  revokedAt         DateTime?
  /// Rotación: apunta al token que reemplazó a este. Si alguien presenta un
  /// token ya rotado, es reuso → se revoca toda la familia.
  replacedByTokenId String?
  lastUsedAt        DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model VerificationToken {
  id     String @id @default(cuid(2))
  userId String

  tokenHash String           @unique
  type      VerificationType
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid(2))

  /// Null en eventos de cuenta que no pertenecen a ningún Space
  /// (cambio de password, por ejemplo).
  spaceId     String?
  actorUserId String?
  /// Respaldo: si se borra el usuario, el log sigue diciendo quién fue.
  actorName   String

  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipHash     String?

  createdAt DateTime @default(now())

  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actor User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
  @@index([spaceId, entityType, entityId])
}

// ═════════════════════════════ dominio financiero ═══════════════════════════

model Account {
  id      String @id @default(cuid(2))
  spaceId String

  name     String
  type     AccountType
  currency String      @db.Char(3)

  /// Saldo de apertura. El saldo actual NO se guarda: se calcula sumando las
  /// transacciones. Ver BalanceProvider.
  initialBalanceMinor BigInt @default(0)

  color      String?
  icon       String?
  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)

  /// Si la cuenta cuenta para el inicio: aparece en la lista del dashboard Y
  /// suma al patrimonio neto.
  ///
  /// Es UN interruptor y no dos —"ocultar" y "no sumar" por separado— a
  /// propósito: una cuenta escondida que igual moviera el total dejaría un
  /// patrimonio que no se puede explicar mirando la pantalla.
  ///
  /// Sus movimientos siguen contando en reportes y presupuestos: esto decide
  /// qué es "lo mío de todos los días", no qué existe.
  includeInNetWorth Boolean @default(true)

  /// La cuenta que viene elegida al cargar un movimiento.
  ///
  /// Una sola por Space, garantizado por un índice único parcial: dos cuentas
  /// principales no son un estado raro que la pantalla pueda dibujar, son un
  /// empate que alguien tendría que desempatar en cada pantalla.
  ///
  /// Es del Space y no de cada persona a propósito: las cuentas son
  /// compartidas, y en un Space de dos ya hay un acuerdo sobre de dónde sale
  /// la plata del día a día.
  isDefault Boolean @default(false)

  /// Solo para CREDIT_CARD. Rango 1..31 forzado por CHECK en la migración.
  creditClosingDay Int?
  creditDueDay     Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space          Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  savingsGoals   SavingsGoal[]
  debts          Debt[]

  /// Destino de las claves foráneas compuestas del Space. Ver la nota de
  /// "integridad referencial dentro del Space" al pie del archivo.
  @@unique([spaceId, id])
  @@index([spaceId, isArchived, deletedAt])
  @@index([spaceId, sortOrder])
}

model Category {
  id       String  @id @default(cuid(2))
  spaceId  String
  /// Jerarquía de máximo 2 niveles: una categoría con parentId no puede tener
  /// hijas. Se valida en el service, el esquema no lo puede expresar.
  parentId String?

  name      String
  kind      CategoryKind
  icon      String?
  color     String?
  sortOrder Int          @default(0)
  /// Viene del catálogo por defecto que se siembra al crear el Space.
  isSystem  Boolean      @default(false)
  /// Archivada: no se ofrece al cargar, pero el historial queda intacto.
  ///
  /// Es lo que distingue "ya no uso esta categoría" de "esta categoría fue un
  /// error": borrarla reasigna o deja sin categoría los movimientos que la
  /// usaban, y eso reescribe el pasado. Archivar no toca ni una fila.
  isArchived Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space          Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryTree", fields: [spaceId, parentId], references: [spaceId, id], onDelete: Restrict)
  children       Category[]      @relation("CategoryTree")
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([spaceId, id])
  @@index([spaceId, kind, deletedAt])
  @@index([spaceId, parentId])
}

model Transaction {
  id         String  @id @default(cuid(2))
  spaceId    String
  accountId  String
  categoryId String?

  /// SetNull al borrar el usuario para no dejar transacciones huérfanas;
  /// createdByName conserva el dato para siempre.
  createdByUserId String?
  createdByName   String

  /// Quién PUSO la plata, que no es lo mismo que quién cargó el movimiento.
  /// Null = lo pagó el Space (una cuenta común) y no hay nada que repartir.
  /// Es la base del reparto de gastos: sin este dato, "quién le debe a quién"
  /// no se puede calcular.
  paidByUserId String?

  type   TransactionType
  status TransactionStatus @default(CLEARED)

  /// SIEMPRE positivo. El signo lo da `type`. Un CHECK lo garantiza.
  amountMinor BigInt
  currency    String @db.Char(3)

  /// Congelados al crear la transacción. Un reporte histórico nunca se
  /// recalcula con la cotización de hoy.
  exchangeRateSnapshot Decimal? @db.Decimal(24, 12)
  /// amountMinor ya convertido a Space.primaryCurrency. Denormalizado a
  /// propósito: permite sumar reportes en SQL sin joins ni conversiones.
  amountPrimaryMinor   BigInt?

  /// Fecha calendario del hecho económico. Sin hora ni timezone: "lo gasté
  /// el 3 de agosto" es un hecho local, no un instante.
  date        DateTime @db.Date
  description String?
  notes       String?
  payee       String?

  /// Las transferencias son un par de transacciones con el mismo grupo.
  /// "Como mucho una pata por sentido en cada grupo" es un unique PARCIAL
  /// (excluye las borradas): Prisma no lo expresa, va a mano en la migración.
  transferGroupId   String?
  /// Solo en las patas de una transferencia. Un CHECK garantiza que vaya junto
  /// con transferGroupId y solo cuando type = TRANSFER. Otro CHECK impide que
  /// una transferencia lleve categoría.
  transferDirection TransferDirection?
  /// Una regla no puede generar dos veces la misma fecha: unique PARCIAL sobre
  /// (spaceId, recurringRuleId, date) en la migración. Es la idempotencia del
  /// job de materialización, que corre por cron y puede dispararse de más.
  recurringRuleId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [spaceId, accountId], references: [spaceId, id], onDelete: Restrict)
  category      Category?      @relation(fields: [spaceId, categoryId], references: [spaceId, id], onDelete: Restrict)
  recurringRule RecurringRule? @relation(fields: [spaceId, recurringRuleId], references: [spaceId, id], onDelete: Restrict)
  /// User NO es scopeado por Space, así que esta queda simple. SetNull para no
  /// dejar transacciones huérfanas; createdByName conserva quién fue.
  createdBy     User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  paidBy        User?          @relation("TransactionPayer", fields: [paidByUserId], references: [id], onDelete: SetNull)

  tags            TransactionTag[]
  attachments     Attachment[]
  savingsContribs SavingsContribution[]
  debtPayments    DebtPayment[]
  splits          TransactionSplit[]

  @@unique([spaceId, id])
  @@index([spaceId, date, deletedAt])
  @@index([accountId, date])
  @@index([spaceId, categoryId, date])
  @@index([spaceId, createdByUserId, date])
  @@index([spaceId, transferGroupId])
  @@index([recurringRuleId])
  @@index([spaceId, paidByUserId, date])
}

/// Cuánto de un gasto le corresponde a cada miembro.
///
/// Es una ANOTACIÓN, no una deuda: generar una fila de deuda por cada gasto
/// compartido daría cincuenta deudas de siete euros que nadie salda una por
/// una. El saldo entre personas se calcula agregando estos repartos y se salda
/// con un Settlement.
///
/// La suma de los repartos de un movimiento tiene que dar su importe exacto; lo
/// garantiza el service repartiendo con `allocate`, que no pierde ni un céntimo.
model TransactionSplit {
  id            String @id @default(cuid(2))
  spaceId       String
  transactionId String
  /// A quién le toca esta parte. Sin SetNull: si el usuario se va, el reparto
  /// deja de tener sentido y se borra con él.
  userId        String

  amountMinor BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [spaceId, transactionId], references: [spaceId, id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un miembro aparece como mucho una vez por movimiento: unique en la
  /// migración.
  @@index([spaceId, transactionId])
  @@index([spaceId, userId])
}

/// "Estamos a mano": un pago de una persona a otra que cancela lo que se
/// debían de los gastos compartidos.
///
/// No es una Transaction: no mueve el patrimonio del Space, solo reequilibra
/// quién puso qué dentro de él. Si generara un movimiento, el mes en que se
/// saldan las cuentas parecería el mes de un gasto enorme.
model Settlement {
  id         String @id @default(cuid(2))
  spaceId    String
  fromUserId String
  toUserId   String

  amountMinor BigInt
  currency    String   @db.Char(3)
  date        DateTime @db.Date
  note        String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}

model Tag {
  id      String  @id @default(cuid(2))
  spaceId String
  name    String
  color   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space        Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  /// (spaceId, name) único entre los no borrados: unique parcial en la migración.

  @@unique([spaceId, id])
  @@index([spaceId, deletedAt])
}

model TransactionTag {
  transactionId String
  tagId         String
  /// Denormalizado a propósito: mantiene el invariante "toda tabla de dominio
  /// tiene spaceId", así la extensión de scope no necesita excepciones.
  spaceId       String

  createdAt DateTime @default(now())

  transaction Transaction @relation(fields: [spaceId, transactionId], references: [spaceId, id], onDelete: Cascade)
  tag         Tag         @relation(fields: [spaceId, tagId], references: [spaceId, id], onDelete: Cascade)
  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([spaceId, tagId])
}

model Budget {
  id         String  @id @default(cuid(2))
  spaceId    String
  /// Null = presupuesto global del Space.
  categoryId String?

  name        String
  period      BudgetPeriod
  amountMinor BigInt
  currency    String       @db.Char(3)

  startDate DateTime  @db.Date
  /// Obligatoria si period = CUSTOM (CHECK en la migración).
  endDate   DateTime? @db.Date

  rollover Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [spaceId, categoryId], references: [spaceId, id], onDelete: Cascade)

  @@index([spaceId, isActive, deletedAt])
  @@index([spaceId, categoryId])
}

model RecurringRule {
  id         String  @id @default(cuid(2))
  spaceId    String
  accountId  String
  categoryId String?

  createdByUserId String?
  createdByName   String

  type        TransactionType
  amountMinor BigInt
  currency    String          @db.Char(3)
  description String?
  payee       String?

  // RRULE simplificado
  frequency  RecurrenceFrequency
  interval   Int                 @default(1)
  /// MONTHLY / YEARLY: día del mes (1..31)
  byMonthDay Int?
  /// WEEKLY: 0 = domingo … 6 = sábado
  byWeekday  Int?
  /// YEARLY: 1..12
  byMonth    Int?

  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  maxOccurrences Int?

  nextRunDate        DateTime  @db.Date
  lastRunAt          DateTime?
  occurrencesCreated Int       @default(0)
  /// true = las transacciones nacen CLEARED; false = PENDING para revisar.
  autoPost           Boolean   @default(true)
  isActive           Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [spaceId, accountId], references: [spaceId, id], onDelete: Restrict)
  category  Category? @relation(fields: [spaceId, categoryId], references: [spaceId, id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@unique([spaceId, id])
  @@index([spaceId, isActive, nextRunDate])
  /// Barrido global del job de materialización, que cruza todos los Spaces.
  @@index([isActive, nextRunDate])
}

model SavingsGoal {
  id        String  @id @default(cuid(2))
  spaceId   String
  accountId String?

  name              String
  targetAmountMinor BigInt
  currency          String    @db.Char(3)
  targetDate        DateTime? @db.Date
  icon              String?
  color             String?
  achievedAt        DateTime?

  /// La forma elegida para llegar: apartar tanto, cada tanto, desde tal día.
  ///
  /// Los cuatro campos van juntos o ninguno, garantizado por un CHECK, igual
  /// que el plan de una deuda. No lleva tope de aportes: una meta se termina
  /// cuando se junta la plata, no cuando se cumple un número pactado.
  planAmountMinor BigInt?
  planFrequency   RecurrenceFrequency?
  planInterval    Int?
  planStartDate   DateTime?            @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space         Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  account       Account?              @relation(fields: [spaceId, accountId], references: [spaceId, id], onDelete: Restrict)
  contributions SavingsContribution[]

  @@unique([spaceId, id])
  @@index([spaceId, deletedAt])
}

model SavingsContribution {
  id            String  @id @default(cuid(2))
  spaceId       String
  goalId        String
  /// Opcional: un aporte puede o no corresponder a una transacción real.
  transactionId String?

  amountMinor BigInt
  date        DateTime @db.Date
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  goal        SavingsGoal  @relation(fields: [spaceId, goalId], references: [spaceId, id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [spaceId, transactionId], references: [spaceId, id], onDelete: Restrict)

  @@index([spaceId, goalId, date])
}

model Debt {
  id        String  @id @default(cuid(2))
  spaceId   String
  accountId String?

  direction    DebtDirection
  counterparty String
  description  String?

  originalAmountMinor BigInt
  currency            String @db.Char(3)
  /// Basis points (1% = 100). Entero, para no meter floats ni acá.
  interestRateBps     Int?

  startDate         DateTime  @db.Date
  dueDate           DateTime? @db.Date
  installmentsTotal Int?
  closedAt          DateTime?

  /// Plan de pago/cobro pactado: cuánto y cada cuánto. Es el ACUERDO tal como
  /// se pactó, no una cuota calculada — el módulo sigue sin amortizar nada.
  ///
  /// Los cuatro campos van juntos o ninguno, y lo garantiza un CHECK: un
  /// importe sin frecuencia no dice cuándo, y una frecuencia sin importe no
  /// dice cuánto. Se reusa `RecurrenceFrequency` con su `interval` en vez de
  /// un enum propio, así "quincenal" es WEEKLY cada 2 y el motor de
  /// recurrencia —que ya sabe que el 31 vuelve a ser 31 después de febrero—
  /// se usa igual acá que en los movimientos programados.
  ///
  /// `installmentsTotal` lo topea: 12 cuotas son 12 fechas, no infinitas.
  planAmountMinor BigInt?
  planFrequency   RecurrenceFrequency?
  planInterval    Int?
  planStartDate   DateTime?            @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space    Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  account  Account?      @relation(fields: [spaceId, accountId], references: [spaceId, id], onDelete: Restrict)
  payments DebtPayment[]

  /// El saldo NO se guarda: es originalAmountMinor - sum(payments).
  @@unique([spaceId, id])
  @@index([spaceId, closedAt, deletedAt])
}

model DebtPayment {
  id            String  @id @default(cuid(2))
  spaceId       String
  debtId        String
  transactionId String?

  amountMinor   BigInt
  date          DateTime @db.Date
  installmentNo Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  debt        Debt         @relation(fields: [spaceId, debtId], references: [spaceId, id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [spaceId, transactionId], references: [spaceId, id], onDelete: Restrict)

  @@index([spaceId, debtId, date])
}

/// ⚠️ La ÚNICA tabla del dominio sin spaceId: las cotizaciones son globales.
/// Está explícitamente en el allowlist de la extensión de scope.
model ExchangeRate {
  id String @id @default(cuid(2))

  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  date          DateTime @db.Date
  rate          Decimal  @db.Decimal(24, 12)
  /// "manual" en Fase 1. Deja lugar a "ecb", "bcra", etc. sin migrar.
  source        String   @default("manual")

  createdAt DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, date, source])
  @@index([baseCurrency, quoteCurrency, date])
}

model Attachment {
  id            String @id @default(cuid(2))
  spaceId       String
  transactionId String

  /// Clave opaca del storage. La URL la firma el driver; nunca se guarda.
  storageKey       String
  mimeType         String
  sizeBytes        Int
  originalName     String
  uploadedByUserId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [spaceId, transactionId], references: [spaceId, id], onDelete: Cascade)
  uploadedBy  User?       @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([spaceId, transactionId])
}
